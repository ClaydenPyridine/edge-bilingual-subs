{
  "manifest_version": 3,
  "name": "双语字幕 · English → 中文",
  "version": "0.9.0",
  "description": "抓取英文字幕轨或直接识别标签页语音，实时翻译成中文，双语对照显示。",
  "permissions": ["storage", "tabCapture", "offscreen"],
  "host_permissions": ["<all_urls>"],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["src/inject-main.js"],
      "world": "MAIN",
      "run_at": "document_start",
      "all_frames": false
    },
    {
      "matches": ["<all_urls>"],
      "js": ["src/content.js"],
      "css": ["src/overlay.css"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "background": {
    "service_worker": "src/background.js"
  },
  "action": {
    "default_title": "双语字幕：点击开关"
  },
  "options_ui": {
    "page": "src/options.html",
    "open_in_tab": true
  }
}
